{
  "name": "cohive-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "git submodule init && git submodule sync && git submodule update --init --recursive || true",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev ./dist --ip 127.0.0.1 --binding ENVIRONMENT=development --persist-to=.wrangler/state",
    "submodule:init": "git submodule update --init --recursive",
    "submodule:update": "git submodule update --remote"
  },
  "dependencies": {
    "lucide-react": "^0.395.0",
    "marked": "^12.0.0",
    "prismjs": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@types/prismjs": "^1.26.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.2.2",
    "vite": "^8.1.4",
    "wrangler": "^4.106.0"
  }
}